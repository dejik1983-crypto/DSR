<Project Sdk="Microsoft.NET.Sdk">
  <!-- Проверка внутренних методов DSR (Program.ApplyIdioms) без запуска окна.
       Запуск из папки _diag:
         dotnet run                      сборка берётся из <корень>\bin\Debug
         dotnet run с аргументом          путь к DSR.dll
       Объекты по умолчанию попадают в _diag\obj и основному проекту не мешают:
       в FB2AccentConverter.csproj есть Compile Remove для _diag\**\*.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="IdiomProbe.cs" />
  </ItemGroup>
</Project>
