<Window x:Class="FB2AccentConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSR — ударения в FB2/TXT: RUAccent, Silero и доработка"
        Width="1280" Height="920" MinWidth="1020" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F4EDDD"
        Foreground="#3F3025" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#F4EDDD" />
        <SolidColorBrush x:Key="Card" Color="#FCF8EF" />
        <SolidColorBrush x:Key="Ink" Color="#3F3025" />
        <SolidColorBrush x:Key="MutedInk" Color="#70604D" />
        <SolidColorBrush x:Key="Rule" Color="#D2C2A5" />
        <SolidColorBrush x:Key="Accent" Color="#74462A" />
        <SolidColorBrush x:Key="SelectedPaper" Color="#E8D8BA" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#8B5734" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.52" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Переключатель «УНИК»: тот же вид, что у кнопок, но с заметным включённым состоянием. -->
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#8B5734" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.52" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Margin" Value="0,4" /></Style>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8,12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Margin" Value="1,1,1,2" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SelectedPaper}" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Padding" Value="4,2" /><Setter Property="Margin" Value="0,2,14,2" /></Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFrame" Background="{StaticResource Card}" BorderBrush="{StaticResource Rule}"
                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="{StaticResource SelectedPaper}" />
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#8B5734" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PaperCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- Производный путь: приложение назначает его само, менять вручную нельзя. -->
        <Style x:Key="DerivedPath" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,2,2,2" />
            <Setter Property="ToolTip" Value="Путь определяется автоматически по указанной книге" />
        </Style>
        <Style x:Key="LetterButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="5,1,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#8B5734" />
                                <Setter TargetName="Chip" Property="Background" Value="#FFF3D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ReviewSampleTemplate">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" Margin="2,2,8,2" IsChecked="{Binding Included, Mode=OneWay}" Tag="{Binding Index}" Click="SampleInclude_Click" />
                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Exact, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="{Binding After, Mode=OneWay}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="#9A5B22" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>
        <!-- Случай на странице контроля. Строкой показан сокращённо: один щелчок раскрывает
             фрагмент целиком для чтения, и проверяемое слово подсвечивается так же, как в окне
             ручной доводки (крупнее, жирнее, на светлом фоне). Двойной щелчок переносит случай
             в другое окно, правая кнопка открывает меню.
             Раскрыт всегда один случай: предыдущий сворачивается и помечается просмотренным —
             полоской слева и спокойным фоном. Так видно, что уже прочитано, а что нет. -->
        <DataTemplate x:Key="ControlCaseTemplate">
            <Border x:Name="CaseCard" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="3,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Метка перенесённого случая: ИИ предлагала другое ударение, чем вы оставили.
                         У остальных случаев метки нет. -->
                    <TextBlock Grid.Column="0" x:Name="AiMark" Text="{Binding Mark, Mode=OneWay}"
                               Foreground="#A0532C" FontWeight="Bold" Margin="2,3,4,0"
                               ToolTip="{Binding MarkHint, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mark, Mode=OneWay}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- «?» — перенос на предлог, который стоит проверить глазами. -->
                                    <DataTrigger Binding="{Binding Mark, Mode=OneWay}" Value="?">
                                        <Setter Property="Foreground" Value="#B06A14" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="FoldedCase" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,3">
                            <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Exact, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="{Binding After, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Name="ExpandedCase" TextWrapping="Wrap" Margin="2,3" Visibility="Collapsed">
                            <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Exact, Mode=OneWay}" FontWeight="Black" Foreground="{StaticResource Accent}" Background="#FFF3D6" /><Run Text="{Binding After, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsViewed, Mode=OneWay}" Value="True">
                    <Setter TargetName="CaseCard" Property="BorderBrush" Value="#A8B98C" />
                    <Setter TargetName="CaseCard" Property="Background" Value="#F3F6EA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded, Mode=OneWay}" Value="True">
                    <Setter TargetName="FoldedCase" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ExpandedCase" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CaseCard" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="CaseCard" Property="Background" Value="#FCF3DB" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Шапка и строка статуса получают фиксированную высоту (см. FitWindowLayout): при
         крупном масштабе шрифтов или маленьком экране вкладка поджимает их, и содержимое
         шапки «Расстановка ударений и доработка» оказывается под вкладкой. Фиксированные
         строки уступают место вкладкам, а не наоборот. -->
    <Grid Margin="14" Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="HeaderRow" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" x:Name="StatusRow" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,8" ClipToBounds="True">
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                <Button x:Name="HelpButton" Content="Как это работает?" Padding="10,5" HorizontalAlignment="Right"
                        ToolTip="Краткая инструкция по всему процессу" />
                <!-- Подсказок в приложении много, и знакомому пользователю они мешают: галочка
                     убирает их все сразу. Как именно — см. статический конструктор MainWindow:
                     событие открытия подсказки перехватывается по классам элементов, поэтому
                     трогать ни элементы, ни шаблоны не нужно. -->
                <CheckBox x:Name="HideToolTipsCheckBox" Content="Выключить всплывающие подсказки" Margin="0,6,0,0"
                          HorizontalAlignment="Right"
                          ToolTip="Убирает все всплывающие подсказки в приложении. Выбор сохраняется и действует при следующем запуске." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Расстановка ударений и доработка" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Этапный конвейер: add-stress (база) → RUAccent + Silero по словам без ударения → спорно/сомнительно/опечатка → ручная доводка. Исходный файл не изменяется." Style="{StaticResource Note}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Note}" Margin="8,0,0,0"
                               ToolTip="Версия DSR. Обновление версии само запускает подготовку окружения." />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="ReviewTabs" ClipToBounds="True">

            <!-- ======================= 1. ОБРАБОТКА КНИГИ ======================= -->
            <TabItem Header="1. Обработка книги">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource PaperCard}" Margin="0,8,0,10">
                            <StackPanel>
                                <TextBlock Text="Один запуск — два движка и сравнение" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                                           Text="DSR сам прогонит исходную книгу через RUAccent, затем через Silero, сравнит оба результата и оставит только расхождения. Исходник не перезаписывается: вся работа идёт в папке «DSR_имя книги» рядом с ним — отдельно прогон RUAccent, отдельно Silero со своими отчётами, затем расхождения для ИИ и ручной доводки." />
                            </StackPanel>
                        </Border>

                        <GroupBox Header="Параметры обработки"
                                  ToolTip="Модель меняет только модель омографов RUAccent: big_poetry — модель омографов (лучшее качество). CUDA используется RUAccent через ONNX Runtime и доступна только для NVIDIA RTX. Движки подсказок на PyTorch (silero-stress, omogre) считают на устройстве, которое выбирается во вкладке «2. Расхождения и ИИ».">
                            <StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Модель RUAccent:" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ModelComboBox" Width="150" />
                                    <TextBlock Text="Устройство RUAccent:" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                                    <ComboBox x:Name="DeviceComboBox" Width="110" />
                                    <Button x:Name="GpuTestButton" Content="Проверить GPU / CUDA" Margin="10,0,0,0"
                                            ToolTip="Перепроверяет NVIDIA RTX и CUDA-провайдер ONNX Runtime. Обычно вручную нажимать не нужно: проверка уже выполняется при подготовке." />
                                    <CheckBox x:Name="IllustrationsCheckBox" Content="Сохранить иллюстрации" IsChecked="True" IsEnabled="False" Margin="14,0,0,0"
                                              ToolTip="Действует для FB2: изображения попадут в результат без изменений." />
                                </WrapPanel>
                                <CheckBox x:Name="SileroCompareCheckBox" Margin="0,6,0,0" IsChecked="True"
                                          Content="Второе мнение: прогонять Silero и сравнивать с RUAccent"
                                          ToolTip="Включено (рекомендуется): после RUAccent DSR прогонит исходную книгу через Silero и соберёт расхождения — именно они уходят на ИИ и в ручную доводку. Выключите, если Silero не установлен или нужен только RUAccent: тогда на доработку пойдёт список слов, которые RUAccent оставил без ударения." />
                                <TextBlock x:Name="GpuStatusText" Text="Проверка NVIDIA RTX…" Style="{StaticResource Note}" Margin="0,6,0,0" />
                                <TextBlock x:Name="ModelStatusText" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Книга и рабочая папка"
                                  ToolTip="Исходная книга — что обрабатываем; она никогда не изменяется. Вся работа идёт в папке «DSR_имя книги» рядом с ней. Отчёт расхождений и редактируемый файл подставляются автоматически после обработки.">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Книга:" Style="{StaticResource FieldLabel}" Margin="0,3,8,3" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputTextBox" IsReadOnly="True" Margin="0,2" ToolTip="Исходный FB2 или TXT. Не изменяется." />
                                <Button Grid.Row="0" Grid.Column="2" x:Name="BrowseInputButton" Content="Выбрать…" Margin="8,2,0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Рабочая папка:" Style="{StaticResource FieldLabel}" Margin="0,3,8,3" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="WorkspaceTextBox" IsReadOnly="True" Margin="0,2"
                                         FontSize="12" Style="{StaticResource DerivedPath}"
                                         ToolTip="Сюда DSR складывает прогоны RUAccent и Silero, отчёт расхождений, словоформы и итог." />
                                <Button Grid.Row="1" Grid.Column="2" x:Name="OpenWorkspaceButton" Content="Показать" Margin="8,2,0,2" IsEnabled="False"
                                        ToolTip="Открыть папку DSR_имя книги в проводнике." />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Результат RUAccent:" Style="{StaticResource FieldLabel}" Margin="0,3,8,3" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputTextBox" IsReadOnly="True" Margin="0,2"
                                         FontSize="12" Style="{StaticResource DerivedPath}"
                                         ToolTip="Книга с ударениями RUAccent внутри рабочей папки: это основа для правок." />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Отчёт расхождений:" Style="{StaticResource FieldLabel}" Margin="0,3,8,3" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ReviewFileTextBox" IsReadOnly="True" Margin="0,2" ToolTip="Отчёт расхождений RUAccent и Silero — слова для ИИ и ручной доводки" />
                                <Button Grid.Row="3" Grid.Column="2" x:Name="ChooseReviewButton" Content="Отчёт…" Margin="8,2,0,2" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Правки в:" Style="{StaticResource FieldLabel}" Margin="0,3,8,3" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="Fb2FileTextBox" IsReadOnly="True" Margin="0,2"
                                         FontSize="12" Style="{StaticResource DerivedPath}"
                                         ToolTip="Книга, к которой применяются правки: результат RUAccent (FB2 или TXT)" />
                                <Button Grid.Row="4" Grid.Column="2" x:Name="ChooseFb2Button" Content="Файл…" Margin="8,2,0,2" />

                                <!-- Производные пути: приложение само решает, куда положит итог, словоформы и статистику. -->
                                <TextBlock Grid.Row="5" Grid.Column="0" x:Name="CorrectedPathLabel" Text="Отредактир.:" Style="{StaticResource FieldLabel}" Margin="0,4,8,2" Visibility="Collapsed" />
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CorrectedFileTextBox" IsReadOnly="True" Margin="0,3,0,1"
                                         FontSize="12" Style="{StaticResource DerivedPath}" Visibility="Collapsed"
                                         ToolTip="Итог, который создаст «Применить всё и сохранить»: «имя_итог» в рабочей папке" />

                                <TextBlock Grid.Row="6" Grid.Column="0" x:Name="FormsPathLabel" Text="Правки (формы):" Style="{StaticResource FieldLabel}" Margin="0,4,8,2" Visibility="Collapsed" />
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="FormsFileTextBox" IsReadOnly="True" Margin="0,3,0,1"
                                         FontSize="12" Style="{StaticResource DerivedPath}" Visibility="Collapsed"
                                         ToolTip="Файл с сохранёнными исправлениями и словоформами: рядом с отчётом расхождений" />

                                <TextBlock Grid.Row="7" Grid.Column="0" x:Name="StatsPathLabel" Text="Статистика:" Style="{StaticResource FieldLabel}" Margin="0,4,8,2" Visibility="Collapsed" />
                                <TextBox Grid.Row="7" Grid.Column="1" x:Name="StatsFileTextBox" IsReadOnly="True" Margin="0,3,0,1"
                                         FontSize="12" Style="{StaticResource DerivedPath}" Visibility="Collapsed"
                                         ToolTip="Отчёты со статистикой: по прогону RUAccent, по прогону Silero и по сравнению" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Запуск и контроль">
                            <StackPanel>
                                <WrapPanel>
                                    <Button x:Name="ConvertButton" Content="Обработать книгу (RUAccent + Silero)" Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"
                                            ToolTip="Прогоняет исходник через RUAccent, затем через Silero и сравнивает результаты. После этого открывается вкладка «2. Расхождения и ИИ»." />
                                     <Button x:Name="ConvertStressAnchorButton" Content="Обработать через add-stress-to-epub" Background="#2E7D32" Foreground="White" FontWeight="SemiBold"
                                             ToolTip="Использует spaCy + Wiktionary (add-stress-to-epub) для расстановки ударений. Работает через DSR FB2-парсер." />
                                    <Button x:Name="ConvertStagedButton" Content="Обработать по этапам (add-stress → RUAccent + Silero)" Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                                            ToolTip="Этапный конвейер: add-stress-to-epub создаёт базу, затем RUAccent и Silero заполняют только слова без ударения в базе. Результаты сравниваются и делятся на «спорно», «сомнительно» и «неизвестно/опечатка». Итог собирается на вкладке ручной доводки из базы." />
                                    <Button x:Name="PauseConversionButton" Content="Пауза" IsEnabled="False" />
                                    <Button x:Name="StopConversionButton" Content="Стоп" IsEnabled="False" />
                                    <Button x:Name="PrepareButton" Content="Подготовка к работе"
                                            ToolTip="Проверяет и при необходимости скачивает Python, пакеты и модель. Обычно нажимать не нужно: DSR делает это сам при первом запуске, в новом месте, на новом компьютере и после смены модели." />
                                    <Button x:Name="ReviewWordsButton" Content="Перейти к расхождениям и ИИ…" IsEnabled="False"
                                            ToolTip="Открывает вкладку «2. Расхождения и ИИ»: подставляет результат последнего запуска и список расхождений." />
                                    <Button x:Name="LoadFilesButton" Content="Открыть отчёт и файл"
                                            ToolTip="Загружает указанные отчёт расхождений и редактируемый файл в список слов." />
                                    <Button x:Name="ContinueWorkButton" Content="Продолжить работу" IsEnabled="False"
                                            ToolTip="Открывает документ, который вы проверяли в прошлый раз: отчёт расхождений и уже отредактированный файл." />
                                </WrapPanel>
                                <ProgressBar x:Name="ConversionProgressBar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="ConversionStatsText" Style="{StaticResource Note}" Margin="0,2,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Ресурсы">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CPU" /><ProgressBar x:Name="CpuUsageBar" Grid.Row="0" Grid.Column="1" Maximum="100" Height="7" Margin="0,4,10,4" /><TextBlock x:Name="CpuLabel" Grid.Row="0" Grid.Column="2" Text="CPU: измерение…" Style="{StaticResource Note}" />
                                    <TextBlock Grid.Row="1" Text="ОЗУ" /><ProgressBar x:Name="MemoryUsageBar" Grid.Row="1" Grid.Column="1" Maximum="100" Height="7" Margin="0,4,10,4" /><TextBlock x:Name="MemoryLabel" Grid.Row="1" Grid.Column="2" Text="ОЗУ: измерение…" Style="{StaticResource Note}" />
                                    <TextBlock Grid.Row="2" Text="GPU" /><ProgressBar x:Name="GpuUsageBar" Grid.Row="2" Grid.Column="1" Maximum="100" Height="7" Margin="0,4,10,4" /><TextBlock x:Name="GpuLabel" Grid.Row="2" Grid.Column="2" Text="GPU: поиск…" Style="{StaticResource Note}" />
                                    <TextBlock Grid.Row="3" Text="Сеть" /><ProgressBar x:Name="NetworkUsageBar" Grid.Row="3" Grid.Column="1" Maximum="100" Height="7" Margin="0,4,10,4" /><TextBlock x:Name="NetworkLabel" Grid.Row="3" Grid.Column="2" Text="Сеть: измерение…" Style="{StaticResource Note}" />
                                </Grid>
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="CheckResourcesButton" Content="Проверить ресурсы"
                                                ToolTip="Глубокая проверка: встроенные словари, движок add-stress, Python, пакеты RUAccent/ONNX Runtime и файлы модели. Ничего не скачивает." />
                                        <Button x:Name="ReloadResourcesButton" Content="Загрузить ресурсы заново"
                                                ToolTip="Удаляет папку ресурсов и заново скачивает Python, пакеты и модели. DSR.exe и ваши книги не затрагиваются." />
                                        <Button x:Name="ClearCacheButton" Content="Очистить всё"
                                                ToolTip="Удаляет всю папку ресурсов рядом с приложением: Python, модели, кэш, словари и служебные настройки. DSR.exe и ваши книги не затрагиваются." />
                                    </StackPanel>
                                    <TextBlock x:Name="ResourceSizeStatusText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================= 2. РАСХОЖДЕНИЯ И ИИ ======================= -->
            <TabItem Header="2. Расхождения и ИИ">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PaperCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                                       Text="Здесь только слова, по которым RUAccent и Silero поставили ударение на разные гласные. Необязательный ИИ-проход разбирает их по контексту на вкладке «3. Контроль ИИ результатов». В ручную доводку (вкладка 4) фрагменты не попадают сами: их переносят туда перетаскиванием на заголовок вкладки; перенесённое исчезает из этого списка и из контроля ИИ." />
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Движок подсказок:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="LlmProviderComboBox" Width="250"
                                          ToolTip="omogre — локальная контекстная модель омографов (разбирает спорные случаи по предложению). Своя модель на диске — файлы в папке ресурсы\модели\llm. Ollama — ваш локальный сервер. Внешний API — сервис с OpenAI-совместимым интерфейсом (OpenAI, OpenRouter, LM Studio, llama.cpp, vLLM)." />
                                <CheckBox x:Name="LlmReuseCheckBox" Margin="14,0,0,0" VerticalAlignment="Center"
                                          Content="Не переспрашивать уже отвеченные слова"
                                          ToolTip="Включено: если подсказка для слова уже есть (у любого движка), слово не отправляется. Снимите галочку, чтобы новый движок проверил заново все слова, по которым отвечали другие." />
                            </WrapPanel>

                            <DockPanel x:Name="LlmOmogrePanel" Margin="0,6,0,0">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Note}"
                                           Text="Контекстная модель омографов: выбирает ударение по предложению, а не по слову (за́мок/замо́к, сто́ит/стои́т, му́ку/мука́). Работает полностью локально. При первом запуске ставится библиотека и PyTorch (CPU), модель около 120 МБ скачивается один раз в ресурсы\модели\omogre." />
                            </DockPanel>

                            <DockPanel x:Name="LlmLocalPanel" Margin="0,6,0,0">
                                <Button x:Name="LlmLocalRefreshButton" DockPanel.Dock="Right" Content="Обновить" Padding="10,5" Margin="8,0,0,0" />
                                <ComboBox x:Name="LlmModelComboBox"
                                          ToolTip="Всё, что лежит в ресурсы\модели\llm и содержит genai_config.json. Чтобы добавить модель, положите её папку туда — она появится в списке." />
                            </DockPanel>

                            <DockPanel x:Name="LlmOllamaPanel" Margin="0,6,0,0">
                                <Button x:Name="LlmOllamaRefreshButton" DockPanel.Dock="Right" Content="Список моделей" Padding="10,5" Margin="8,0,0,0" />
                                <TextBlock Text="Адрес:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="LlmOllamaUrlTextBox" Width="190" Margin="0,0,12,0" ToolTip="Обычно http://127.0.0.1:11434" />
                                <TextBlock Text="Модель:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="LlmOllamaModelComboBox" IsEditable="True" MinWidth="170"
                                          ToolTip="Имя модели в Ollama. Подходит любая загруженная модель: ollama pull имя-модели." />
                            </DockPanel>

                            <StackPanel x:Name="LlmApiPanel" Margin="0,6,0,0">
                                <DockPanel>
                                    <Button x:Name="LlmApiRefreshButton" DockPanel.Dock="Right" Content="Список моделей" Padding="10,5" Margin="8,0,0,0" />
                                    <TextBlock Text="Адрес:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LlmApiUrlTextBox" Width="230" Margin="0,0,12,0"
                                             ToolTip="Адрес вместе с версией, например https://api.openai.com/v1" />
                                    <TextBlock Text="Ключ:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="LlmApiKeyTextBox" MinWidth="120"
                                             ToolTip="Ключ сохраняется в файле ресурсы\llm-настройки.json в открытом виде — не передавайте этот файл другим. Вместо него можно задать переменную окружения DSR_LLM_API_KEY." />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="Модель:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="LlmApiModelComboBox" IsEditable="True" MinWidth="220"
                                              ToolTip="Например gpt-4o-mini, deepseek-chat, openrouter/... — имя зависит от сервиса." />
                                </DockPanel>
                            </StackPanel>

                            <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Видеокарта для движков подсказок (silero-stress, omogre):" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <ComboBox x:Name="LlmDeviceComboBox" Width="165"
                                          ToolTip="Где считать локальные движки подсказок. «Процессор» работает всегда. «Видеокарта» уводит на NVIDIA счёт сети — это самая долгая часть разбора расхождений, — но нужна сборка PyTorch с CUDA (около трёх гигабайт), её ставит кнопка правее. Выбор сохраняется до следующего запуска." />
                                <Button x:Name="LlmCudaProbeButton" Content="Проверить" Padding="10,5" Margin="8,0,0,0"
                                        ToolTip="Показывает, какая сборка PyTorch стоит и видит ли она видеокарту. Ничего не меняет и ничего не скачивает." />
                                <Button x:Name="LlmCudaInstallButton" Content="Поставить сборку с CUDA" Padding="10,5" Margin="8,0,0,0"
                                        ToolTip="Скачивает сборку PyTorch с поддержкой CUDA (около трёх гигабайт) и заменяет ею сборку для процессора; если что-то не выйдет, вернёт прежнюю. После установки кнопка меняется на «Вернуть сборку для процессора»." />
                            </WrapPanel>
                            <TextBlock x:Name="LlmDeviceStatusTextBlock" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="LlmBenchmarkButton" DockPanel.Dock="Left" Content="Проверить движок"
                                        ToolTip="Прогоняет 31 контрольное слово с заранее известным ударением и показывает, сколько движок угадал и за какое время." />
                                <TextBlock x:Name="LlmBenchmarkTextBlock" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Note}" />
                            </DockPanel>
                            <TextBlock x:Name="LlmEngineTextBlock" Style="{StaticResource Note}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PaperCard}"
                            ToolTip="Проход ИИ можно пропустить. Найденное — только подсказки: omogre дополнительно раскладывает омографы по случаям на вкладке «3. Контроль ИИ результатов», окончательно каждая правка принимается на вкладке «4. Ручная доводка».">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <Button x:Name="ManualReviewStepButton" DockPanel.Dock="Right" Content="Пропустить ИИ → ручной выбор" Padding="12,7" Margin="0,0,8,0"
                                        ToolTip="Переходит к ручному выбору по всем расхождениям. ИИ-этап необязателен." />
                                <Button x:Name="LlmRecheckButton" DockPanel.Dock="Right" Content="Перепроверить с помощью ИИ" Padding="14,8" Margin="0,0,8,0"
                                        ToolTip="Спрашивает движок заново по всем словам из отчёта расхождений." />
                                <Button x:Name="LlmCheckButton" DockPanel.Dock="Right" Content="Подсказки ИИ по расхождениям" Padding="14,8"
                                        Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"
                                        ToolTip="Запустить необязательный этап ИИ по словам из отчёта расхождений. Ответы останутся вариантами, текст автоматически не меняется." />
                                <CheckBox x:Name="ShowCheckedCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                          Content="Показывать проверенные"
                                          ToolTip="Слова, к которым правка уже применена, отмечены галочкой и по умолчанию скрыты. Снимите галочку, чтобы вернуться к любому из них и изменить решение — сам документ и список слов при этом не теряются." />
                                <TextBlock Text="Расхождения RUAccent / Silero" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" x:Name="DisagreementSummaryTextBlock" Style="{StaticResource Note}" Margin="0,0,0,6"
                                       Text="Отчёт расхождений появится после обработки книги на вкладке 1."
                                       ToolTip="Сколько расхождений найдено, по скольким ИИ дал подсказку и по скольким нет." />

                            <ListBox Grid.Row="2" x:Name="UnrecognizedWordsListBox" DisplayMemberPath="Display"
                                     ToolTip="Слова, для которых RUAccent и Silero поставили ударение на разные гласные. Двойной щелчок открывает слово на вкладке ручной доводки." />

                            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                <Button x:Name="ApplyAllButton" Content="Применить все правки → итог" IsEnabled="False"
                                        Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"
                                        ToolTip="Применяет все внесённые правки по группам и сохранённые словоформы за один раз; исходный файл не изменяется." />
                                <Button x:Name="OpenCorrectionsButton" Content="Открыть файл форм слов" IsEnabled="False" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 3. КОНТРОЛЬ ИИ РЕЗУЛЬТАТОВ ============ -->
            <TabItem Header="3. Контроль ИИ результатов">
                <Border Style="{StaticResource PaperCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Компактная шапка: слово, листание и размер шрифта в одной строке.
                             Подробная инструкция убрана в подсказку — она больше не отнимает
                             высоту у окон с примерами. -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <Button x:Name="ControlPreviousWordButton" DockPanel.Dock="Left" Content="◀ Слово"
                                    Padding="10,6" VerticalAlignment="Center"
                                    ToolTip="Предыдущее слово с разными вариантами ударения." />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ControlFontSmallerButton" Content="A−" Width="34" Padding="0"
                                        Margin="0,0,4,0" ToolTip="Мельче: уменьшить шрифт примеров в окнах." />
                                <Button x:Name="ControlFontLargerButton" Content="A+" Width="34" Padding="0"
                                        Margin="0,0,10,0" ToolTip="Крупнее: увеличить шрифт примеров в окнах." />
                                <Button x:Name="ControlNextWordButton" Content="Слово ▶" Padding="10,6"
                                        ToolTip="Следующее слово с разными вариантами ударения." />
                            </StackPanel>
                            <TextBlock x:Name="ControlWordTextBlock" FontSize="28" FontWeight="Bold"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Accent}">
                                <TextBlock.ToolTip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="520"
                                               Text="Сверху — слово. Слева — вариант 1 (общая форма группы), справа — вариант 2 (случаи с другим ударением), третье окно — энклиномены: ударение уходит на предлог («на́ пол», «на́ ноги»), слово остаётся без знака и только в этом месте. Если разбор не знает слово, случай всё равно можно перенести в третье окно вручную. Один щелчок раскрывает фрагмент целиком, двойной переносит случай в другое окно, случай можно перетащить мышкой, правая кнопка открывает меню. Раскрыт всегда один случай: прежний сворачивается и помечается прочитанным. Перенос можно отменить, а все правки видны в журнале и сохраняются в txt." />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,6">
                            <TextBlock x:Name="ControlPositionTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Style="{StaticResource Note}" Margin="0,0,12,0" />
                            <TextBlock x:Name="ControlSummaryTextBlock" Style="{StaticResource Note}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Text="После обработки ИИ (omogre) здесь появится разбор по каждому случаю: слово и два варианта ударения, случаи разложены по окнам. Пока прогона не было, страница пуста — запустите «Подсказки ИИ по расхождениям» на вкладке 2.">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="620"
                                                   Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DockPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" MinWidth="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" MinWidth="200" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,6,0"
                                       ToolTip="Случаи, у которых ударение совпадает с вариантом 1 (общая форма группы). Один щелчок раскрывает фрагмент целиком, двойной — переносит случай в правое окно; случай можно перетащить мышкой.">
                                <TextBlock DockPanel.Dock="Top" x:Name="ControlLeftHeaderTextBlock" FontWeight="SemiBold"
                                           Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <ListBox x:Name="ControlLeftCasesListBox" SelectionMode="Single" AllowDrop="True"
                                         ItemTemplate="{StaticResource ControlCaseTemplate}"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <!-- Раскрытый фрагмент переносится по строкам: содержимому нужна
                                         вся ширина окна, иначе переносить текст некуда. -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </DockPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
                                <Button x:Name="ControlMoveRightButton" Content="→" FontSize="20" Padding="10,6" Margin="0,0,0,8"
                                        ToolTip="Перенести выбранный случай в правое окно: у него будет вариант 2." />
                                <Button x:Name="ControlMoveLeftButton" Content="←" FontSize="20" Padding="10,6"
                                        ToolTip="Перенести выбранный случай в левое окно: у него будет вариант 1." />
                            </StackPanel>

                            <DockPanel Grid.Column="2" Margin="6,0,6,0"
                                       ToolTip="Случаи с отдельным ударением (вариант 2). Один щелчок раскрывает фрагмент целиком, двойной — переносит случай в левое окно; случай можно перетащить мышкой.">
                                <TextBlock DockPanel.Dock="Top" x:Name="ControlRightHeaderTextBlock" FontWeight="SemiBold"
                                           Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <ListBox x:Name="ControlRightCasesListBox" SelectionMode="Single" AllowDrop="True"
                                         ItemTemplate="{StaticResource ControlCaseTemplate}"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </DockPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,4,0">
                                <Button x:Name="ControlMoveToPrepositionButton" Content="⇢" FontSize="20" Padding="10,6" Margin="0,0,0,8"
                                        ToolTip="Ударение на предлог: «по́ полу», «на́ ноги». Слово остаётся безударным, и только в этом месте. Переносится случай, выделенный в любом из окон. Если слово не входит в список энклиноменов, перенос всё равно доступен вручную — проверьте предлог глазами." />
                                <Button x:Name="ControlMoveFromPrepositionButton" Content="⇠" FontSize="20" Padding="10,6"
                                        ToolTip="Вернуть ударение в слово: случай уходит из третьего окна в вариант 1." />
                            </StackPanel>

                            <DockPanel Grid.Column="4" Margin="6,0,0,0"
                                       ToolTip="Энклиномены: предлог перетягивает ударение на себя, слово произносится без ударения («на́ пол», «по́ полу», «и́з дому», «на́ ноги»). Знак ставится на предлог и только для этого вхождения. Рядом с вопросом — случаи, перенесённые вручную или с ещё одним словом после проверяемого: их надо проверить глазами.">
                                <TextBlock DockPanel.Dock="Top" x:Name="ControlEnclinomenHeaderTextBlock" FontWeight="SemiBold"
                                           Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <ListBox x:Name="ControlEnclinomenCasesListBox" SelectionMode="Single" AllowDrop="True"
                                         ItemTemplate="{StaticResource ControlCaseTemplate}"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </DockPanel>
                        </Grid>

                        <!-- Действия — одной строкой: на узком окне WrapPanel переносит кнопки,
                             не отнимая у примеров постоянные два ряда высоты. -->
                        <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                            <Button x:Name="ControlUndoButton" Content="Отменить перенос" Padding="9,5" Margin="0,0,6,6"
                                    ToolTip="Возвращает последний перенос туда, где случай был до него. Отменять можно по шагам назад — каждый перенос записан в журнал правок." />
                            <Button x:Name="ControlJournalButton" Content="Журнал правок" Padding="9,5" Margin="0,0,6,6"
                                    ToolTip="Все переносы случаев и отмены: время, слово, что заменено на что. Двойной щелчок по строке открывает этот случай здесь же, список сохраняется в txt-документ." />
                            <Button x:Name="ControlResetViewedButton" Content="Сбросить прочитанное" Padding="9,5" Margin="0,0,6,6"
                                    ToolTip="Убирает пометки «прочитано» у всех случаев: слово можно пройти заново. Статистика точности начнёт считаться заново, переносы случаев останутся." />
                            <Button x:Name="ControlAccuracyButton" Content="Отчёт о точности" Padding="9,5" Margin="0,0,6,6"
                                    ToolTip="Считает, в каких случаях ИИ была права, а в каких вы перенесли случай, сравнивает с RUAccent и Silero и сохраняет отчёт рядом с отчётом расхождений. Каждый проверенный случай пишется в журнал примеров для обучения моделей." />
                            <Button x:Name="ControlSaveButton" Content="Сохранить контроль" Padding="9,5" Margin="0,0,6,6"
                                    ToolTip="Записывает общие формы и отдельные ударения случаев в отчёт, чтобы к работе можно было вернуться. Рядом с отчётом сохраняются журнал правок и отчёт о точности ИИ." />
                            <Button x:Name="ControlToManualButton" Content="Перейти к ручной доводке →" Padding="9,5" Margin="0,0,0,6"
                                    ToolTip="Открывает вкладку 4, переносит туда слово, открытое сейчас в контроле ИИ, и раскрывает выбранный случай. Из контроля ИИ слово исчезает; вернуть его можно перетаскиванием обратно на заголовок вкладки 3." />
                        </WrapPanel>

                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================= 4. РУЧНАЯ ДОВОДКА ======================= -->
            <TabItem Header="4. Ручная доводка">
                <Border Style="{StaticResource PaperCard}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,6" VerticalAlignment="Center">
                                <TextBlock Text="Шрифт:" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}" Margin="0,0,4,0" />
                                <Button x:Name="FontSmallerButton" Content="A−" Width="34" Padding="0" Margin="0,0,4,0"
                                        ToolTip="Мельче: уменьшить шрифт текста и списков" />
                                <Button x:Name="FontLargerButton" Content="A+" Width="34" Padding="0"
                                        ToolTip="Крупнее: увеличить шрифт текста и списков" />
                            </StackPanel>
                            <ComboBox x:Name="SortModeComboBox" DockPanel.Dock="Right" Width="180" Margin="8,0,0,6" />
                            <CheckBox x:Name="ShowCheckedManualCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Content="Показывать проверенные"
                                      ToolTip="Слова с уже применённой правкой отмечены галочкой и по умолчанию скрыты. Снимите галочку, чтобы вернуться к любому из них." />
                            <TextBlock Text="Показывать:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="ManualFilterComboBox" Width="220" Margin="0,0,0,6"
                                      ToolTip="Вкладка наполняется перетаскиванием фрагментов на её заголовок из списков вкладок 2–3: ничего лишнего здесь не появляется. Фильтр: всё перенесённое, только то, где ИИ не разобрала, или только слова без ударения у обеих моделей." />
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <TextBox x:Name="SearchTextBox" MinWidth="120" Margin="0,0,0,6" ToolTip="Фильтр по слову или контексту" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.3*" MinWidth="320" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,6,0"
                                       ToolTip="Выберите слово в верхнем списке, затем конкретный контекст ниже. Снимите флажок у контекста — и ему можно задать отдельное ударение; остальные образцы под галочкой берут общую форму.">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock DockPanel.Dock="Top" Text="Группы слов" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ListBox x:Name="WordGroupsListBox" MinWidth="220" SelectionMode="Single" DisplayMemberPath="Display" />
                                    </DockPanel>
                                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
                                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="Контексты выбранной группы" FontWeight="SemiBold" Margin="0,0,0,4"
                                                   ToolTip="Строки показаны сокращённо: полный фрагмент открывается справа при выборе контекста." />
                                        <ListBox x:Name="ContextsListBox" SelectionMode="Single" ItemTemplate="{StaticResource ReviewSampleTemplate}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Рабочая область прокручивается целиком. Так панели не могут
                                     наехать друг на друга и редактор не исчезает в невысоком окне. -->
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Рабочие поля остаются скрытыми: написание правится прямо в тексте ниже. -->
                                        <TextBox x:Name="CorrectionTextBox" Visibility="Collapsed" IsTabStop="False" Focusable="False" />
                                        <TextBlock x:Name="ContextTextBlock" Visibility="Collapsed" />

                                        <Border x:Name="AiVerdictPanel" Grid.Row="0" Margin="0,0,0,8" Padding="10,8"
                                                CornerRadius="6" Background="#EEF3E3" BorderBrush="#8FA36B" BorderThickness="1" Visibility="Collapsed">
                                            <TextBlock x:Name="AiVerdictTextBlock" TextWrapping="Wrap" />
                                        </Border>

                                        <Border x:Name="LlmHintPanel" Grid.Row="1" Margin="0,0,0,8" Padding="10,8"
                                                CornerRadius="6" Background="#FFF6E0" BorderBrush="{StaticResource Accent}"
                                                BorderThickness="1" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="ВАРИАНТЫ МОДЕЛЕЙ — выберите, затем подтвердите «Да ✓»" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                                <TextBlock x:Name="LlmHintTextBlock" TextWrapping="Wrap" FontSize="14" />
                                                <WrapPanel x:Name="ModelChoicesPanel" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Row="2">
                                            <Grid>
                                                <TextBlock Text="Ударение в слове" Style="{StaticResource SectionHeader}"
                                                           ToolTip="Клик по гласной ставит на неё ударение. Повторный клик по «е»: сначала «ё», потом просто «е» без ударения. Клик по другой гласной переносит ударение туда. «ё» всегда ударная." />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <ToggleButton x:Name="UniqueStressToggle" Content="УНИК" VerticalAlignment="Top"
                                                                  ToolTip="Редкий случай: клик по любой букве слова ставит ударение на неё. Нужно для слов вроде «свѣ́тлостію», «мѣ́дъ», где ударная не гласная. Пока кнопка выключена, панель под ней не показывается." />
                                                    <Button x:Name="ConfirmStressButton" Content="Да ✓" MinWidth="96" Padding="14,8" Margin="8,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"
                                                            ToolTip="Принять вариант (ударение и/или исправленное написание). На отмеченном образце принимается общая форма группы, на снятом флажком — его отдельное ударение (Ctrl+Enter)" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel x:Name="StressChoicesPanel" Margin="0,2,0,6" />
                                            <TextBlock x:Name="VowelPanelHint" Style="{StaticResource Note}" Margin="0,0,0,4" Visibility="Collapsed"
                                                       Foreground="#9A5B22" TextWrapping="Wrap"
                                                       ToolTip="Такое бывает в словах древней орфографии, где ударная не гласная." />
                                        </StackPanel>

                                        <!-- Редкий случай: ударение падает не на гласную (ѣ, і, ѧ и другие буквы).
                                             Показывается только при включённой кнопке УНИК: нужна она для считанных слов. -->
                                        <StackPanel x:Name="UniqueStressPanelBox" Grid.Row="3" Margin="0,0,0,8" Visibility="Collapsed">
                                            <TextBlock Text="Уникальное ударение" Style="{StaticResource SectionHeader}"
                                                       ToolTip="Кликните по любой букве слова — ударение встанет на неё. Нужно для редких случаев, когда ударная не гласная: «свѣ́тлостію», «мѣ́дъ» и подобные слова древней орфографии." />
                                            <WrapPanel x:Name="UniqueStressPanel" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Row="4" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}"
                                                BorderThickness="1" CornerRadius="4" Padding="10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Фрагмент текста" FontWeight="SemiBold" Margin="0,0,0,4"
                                                           ToolTip="Весь текст вокруг проверяемого слова; само слово выделено жирным и с ударением. Буквы слова можно исправить прямо здесь — при нажатии «Да ✓» будет предложено сохранить исправленное написание." />
                                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                                    <Button x:Name="ResetWordButton" DockPanel.Dock="Right" Content="Вернуть исходное слово" Padding="10,5" Margin="8,0,0,0"
                                                            ToolTip="Отменить правку написания и вернуться к слову из книги." />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="SelectionCountTextBlock" VerticalAlignment="Center" Style="{StaticResource Note}" />
                                                        <TextBlock x:Name="OriginalWordTextBlock" VerticalAlignment="Center" Style="{StaticResource Note}" Margin="14,0,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <RichTextBox x:Name="FragmentEditor" BorderThickness="0" Background="Transparent"
                                                             FontSize="16" AcceptsReturn="False" Height="300"
                                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                             ToolTip="Весь фрагмент текста. Проверяемое слово — жирным и с ударением; буквы слова можно исправить прямо здесь." />
                                            </DockPanel>
                                        </Border>

                                        <Expander Grid.Row="5" Margin="0,8,0,0" Header="Опечатка и дополнительные словоформы"
                                                  ToolTip="Слово с опечаткой правьте прямо в тексте выше — кнопки ударения перестроятся под новое написание. Допускается небольшое число отличий (до 3 букв), чтобы случайно не заменить другое слово. Здесь же можно добавить дополнительные словоформы вручную.">
                                            <StackPanel Margin="0,6,0,0">
                                                <ComboBox x:Name="GrammaticalCaseComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                                <StackPanel x:Name="DeclensionRowsPanel" />
                                                <Button x:Name="AddFormButton" Content="Добавить словоформу" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Кнопка «Да ✓» теперь вверху справа, рядом с «УНИК»: выбрал ударение — сразу подтвердил. -->
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Note}" TextWrapping="Wrap"
                                           Text="Правка идёт по отмеченным образцам (общая форма группы). Снимите галочку у нужного случая и задайте ему отдельное ударение — оно применится только к этому вхождению. Листайте случаи кнопками «◀ Случай / Случай ▶»; «Да ✓» на снятом случае само переходит к следующему." />
                            </Grid>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button x:Name="PreviousButton" Content="◀ Предыдущее слово" IsEnabled="False"
                                    ToolTip="Перейти к предыдущему слову (группе)" />
                            <Button x:Name="NextButton" Content="Следующее слово ▶" IsEnabled="False"
                                    ToolTip="Перейти к следующему слову (группе)" />
                            <Button x:Name="PreviousCaseButton" Content="◀ Случай" IsEnabled="False"
                                    ToolTip="Предыдущий случай (вхождение) этого же слова в списке примеров" />
                            <Button x:Name="NextCaseButton" Content="Случай ▶" IsEnabled="False"
                                    ToolTip="Следующий случай (вхождение) этого же слова. Снимите у нужного случая галочку, чтобы задать ему отдельное ударение." />
                            <TextBlock x:Name="CasePositionTextBlock" VerticalAlignment="Center" Margin="6,0,12,0"
                                       Style="{StaticResource Note}" />
                            <Button x:Name="SaveProgressButton" Content="Сохранить" IsEnabled="False"
                                    ToolTip="Сохраняет прогресс: пометки «Проверено» и уже применённые к файлу правки. Вернуться к работе можно кнопкой «Продолжить работу»." />
                            <Button x:Name="SaveCorrectionButton" Content="Сохранить группу и применить" IsEnabled="False"
                                    ToolTip="Применяет правку выбранной группы и сохраняет её в итоговый файл" />
                            <Button x:Name="FinishWorkButton" Content="Завершить работу" IsEnabled="False"
                                    Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"
                                    ToolTip="Собирает итоговый файл «имя_итог» из базы add-stress и всех внесённых правок" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border x:Name="StatusPanel" Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource Card}" BorderBrush="{StaticResource Rule}"
                BorderThickness="1" CornerRadius="6" Padding="10,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="60">
                <TextBlock x:Name="FileStatusTextBlock" TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                           Text="Выберите книгу на вкладке «1. Обработка книги»." />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
