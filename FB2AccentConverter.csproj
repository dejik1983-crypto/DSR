<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DSR</AssemblyName>
    <RootNamespace>FB2AccentConverter</RootNamespace>
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="publish\**\*.cs" />
    <Page Remove="publish\**\*.xaml" />
    <EmbeddedResource Include="ruaccent_worker.py" LogicalName="DSR.ruaccent_worker.py" />
    <EmbeddedResource Include="llm_stress_worker.py" LogicalName="DSR.llm_stress_worker.py" />
    <EmbeddedResource Include="silero_stress_worker.py" LogicalName="DSR.silero_stress_worker.py" />
    <EmbeddedResource Include="omogre_stress_worker.py" LogicalName="DSR.omogre_stress_worker.py" />
    <EmbeddedResource Include="natasha_stress_worker.py" LogicalName="DSR.natasha_stress_worker.py" />
    <EmbeddedResource Include="add_stress_anchor.py" LogicalName="DSR.add_stress_anchor.py" />
    <EmbeddedResource Include="requirements.txt" LogicalName="DSR.requirements.txt" />
    <!-- Словари едут внутри DSR.exe: рядом с exe не нужна папка dictionary.
         При первом обращении они распаковываются в «ресурсы\dictionary», поэтому
         папку «ресурсы» можно удалить целиком — программа восстановит словари сама. -->
    <EmbeddedResource Include="dictionary\*.txt" LogicalName="DSR.dictionary.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- add-stress-to-epub (spaCy + Wiktionary) — необязательный движок. В exe кладём
       сам пакет и модель spaCy, но не огромные russian_dict.db (1,3 ГБ) и
       simple_cases.pkl (152 МБ): база Wiktionary скачивается библиотекой при первом
       использовании прямо в «ресурсы\add-stress», а pkl необязателен. -->
  <Target Name="PackAddStressEngine" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <AddStressFiles Include="add-stress-to-epub-0.1.22\russian_text_stresser\**\*"
                      Exclude="add-stress-to-epub-0.1.22\russian_text_stresser\russian_dict.db;add-stress-to-epub-0.1.22\russian_text_stresser\simple_cases.pkl;add-stress-to-epub-0.1.22\russian_text_stresser\__pycache__\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(IntermediateOutputPath)add-stress-stage" />
    <Copy SourceFiles="@(AddStressFiles)"
          DestinationFiles="@(AddStressFiles->'$(IntermediateOutputPath)add-stress-stage\russian_text_stresser\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)add-stress-stage"
                  DestinationFile="$(IntermediateOutputPath)russian_text_stresser.zip"
                  Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)russian_text_stresser.zip" LogicalName="DSR.russian_text_stresser.zip" />
    </ItemGroup>
  </Target>
</Project>
